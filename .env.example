# development → usa VITE_API_DEV_URL (json-server local)
# production  → usa VITE_API_PROD_URL (json-server desplegado en Render)
VITE_API_MODE=development
VITE_API_DEV_URL=http://localhost:3000
VITE_API_PROD_URL=https://tu-servicio.onrender.com
VITE_ADMIN_NICKNAME=admin

# En GitHub Actions la URL de producción se toma de la variable/secret del repo VITE_API_URL
